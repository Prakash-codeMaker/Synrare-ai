# SynRareAI Environment Variables
# Copy this file to .env and fill in your values

# ── Backend ───────────────────────────────────────────────────────────────────
# Port for the FastAPI server
PORT=8000

# Optional: Anthropic API key for real LLM-powered reports
# Leave blank to use template-based reports (demo mode)
ANTHROPIC_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Backend URL (used by the React frontend)
VITE_API_URL=http://localhost:8000

# ── Privacy Settings ──────────────────────────────────────────────────────────
# Differential privacy budget (lower = stronger privacy, but less accuracy)
PRIVACY_EPSILON=0.3
PRIVACY_DELTA=0.00001

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to use mock data instead of real ML pipeline
DEMO_MODE=true
